// Rejestr Oprogramowania — schemat bazy danych
// Dokumentacja pól: docs/ARCHITEKTURA.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Role i uprawnienia ───────────────────────────────────────
enum Role {
  SUPER_ADMIN // wszystko + zarządzanie użytkownikami
  ADMIN // CRUD aplikacji + odczyt userów + audyt
  VIEWER // tylko odczyt
}

// ─── Klasyfikacja bezpieczeństwa ──────────────────────────────
enum SecurityClass {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

// ─── Status wdrożenia ─────────────────────────────────────────
enum AppStatus {
  PROD // używana produkcyjnie
  TEST // w testach
  DEV // w środowisku deweloperskim
  PLANNED // zaplanowana, jeszcze nie wdrożona
  DEPRECATED // wycofywana, wciąż w użyciu
  RETIRED // wycofana z użytku
}

// ─── Sposób dostarczenia i wsparcia ────────────────────────────
// Rejestr ma dwa zupełnie różne rodzaje wpisów. Jedne to programy
// instalowane na stanowisku (7-Zip, czytnik PDF), a drugie to usługi,
// do których łączymy się przez adres — hostowane u nas albo u dostawcy.
// Różnią się tym, czego potrzebujemy do opisania: dla usługi liczy się
// nie tylko „co to jest", ale też gdzie działa i do kogo dzwonić,
// gdy przestanie działać.
enum DeliveryType {
  GENERAL_USE    // program na stanowisku użytkownika
  SELF_HOSTED    // usługa na naszej infrastrukturze
  SAAS           // usługa u zewnętrznego dostawcy
  VENDOR_MANAGED // instalowana lokalnie, zarządza nią dostawca
}

// Kto odpowiada za wsparcie: my albo dostawca.
enum SupportOwnerType {
  INTERNAL
  VENDOR
}

// Główny kanał zgłoszeń — wystarczy jeden, bo to coś, czego szuka się
// w pierwszej kolejności.
enum SupportChannel {
  EMAIL
  PHONE
  PORTAL
  CHAT
  ON_SITE
}

// ─── Katalog adresów IP ───────────────────────────────────────
enum IpStatus {
  FREE       // wolny lub zarezerwowany, bez aplikacji
  IN_USE     // przypisany do co najmniej jednej aplikacji
  DEPRECATED // wycofywany, czeka na zwolnienie
}

// ─── Użytkownicy ──────────────────────────────────────────────
model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.Citext
  email        String    @unique @db.Citext
  fullName     String    @map("full_name") @db.VarChar(200)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role      @default(VIEWER)
  isActive     Boolean   @default(true) @map("is_active")
  // Wymuszenie zmiany hasła przy następnym logowaniu
  mustChangePassword Boolean @default(false) @map("must_change_password")
  // Płaska lista do szybkich testów — nie używamy tego w runtime
  passwordChangedAt DateTime? @map("password_changed_at")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Aplikacje, którymi użytkownik administruje
  administeredApps  Application[] @relation("AppAdmins")
  // Aplikacje utworzone przez użytkownika
  createdApps       Application[] @relation("AppCreator")

  sessions  Session[]
  auditLogs AuditLog[]

  @@map("users")
}

// ─── Sesje ────────────────────────────────────────────────────
model Session {
  id String @id @default(uuid()) @db.Uuid

  // W bazie trzymamy wyłącznie skrót tokenu — sam token jest tylko w ciasteczku
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  ip        String? @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(500)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── Środowiska ───────────────────────────────────────────────
model Environment {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.Citext
  // Kolejność na liście rozwijanej
  sortOrder Int       @default(0) @map("sort_order")
  color     String    @default("slate") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")

  applications ApplicationEnvironment[]

  @@map("environments")
}

// ─── Relacja aplikacja ↔ środowisko ──────────────────────────
model ApplicationEnvironment {
  applicationId String     @map("application_id") @db.Uuid
  environmentId String     @map("environment_id") @db.Uuid

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@id([applicationId, environmentId])
  @@index([environmentId])
  @@map("application_environments")
}

// ─── Aplikacje ────────────────────────────────────────────────
model Application {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique @db.Citext
  version     String @db.VarChar(100)

  // Co to jest i do czego służy
  description String? @db.Text
  purpose     String? @db.Text

  // Kto odpowiada — sam adres e-mail, celowo bez relacji do `users`.
  // Właścicielem bywa osoba spoza organizacji albo ktoś bez konta,
  // więc wolny tekst jest tu poprawniejszy niż klucz obcego.
  ownerEmail String? @map("owner_email") @db.Citext
  admins     User[]  @relation("AppAdmins")

  // Kiedy
  introducedOn DateTime? @map("introduced_on") @db.Date
  sunsetOn     DateTime? @map("sunset_on") @db.Date

  // Bezpieczeństwo
  securityClass SecurityClass @default(INTERNAL) @map("security_class")
  // 1 = niska, 4 = krytyczna dla organizacji
  criticality   Int           @default(2) @db.SmallInt
  status        AppStatus     @default(PROD)

  // Czy uzyskanie dostępu do aplikacji wymaga formalnego wniosku
  accessRequestRequired Boolean @default(false) @map("access_request_required")

  // Sposób dostarczenia i hosting
  deliveryType DeliveryType @default(GENERAL_USE) @map("delivery_type")

  // Pola niżej opisują usługę, więc wypełnia się je dla typów innych niż
  // `GENERAL_USE`. Celowo zostają w rekordzie, gdy typ wraca do
  // `GENERAL_USE` — zmiana typu to zmiana opisu, nie skasowanie wiedzy.
  baseUrl         String? @db.VarChar(500) @map("base_url")
  hostingLocation String? @db.VarChar(200) @map("hosting_location")
  adminTeam       String? @db.VarChar(200) @map("admin_team")

  // Wsparcie: kto, jak i pod jakim kontaktem
  supportOwnerType SupportOwnerType? @map("support_owner_type")
  supportOwnerName String?          @db.VarChar(200) @map("support_owner_name")
  supportEmail     String?          @db.Citext @map("support_email")
  supportUrl       String?          @db.VarChar(500) @map("support_url")
  supportChannel   SupportChannel?  @map("support_channel")
  supportNotes     String?          @db.Text @map("support_notes")

  // Dostawca i licencja
  vendor       String? @db.VarChar(200)
  license      String? @db.VarChar(200)
  licenseCount Int?    @map("license_count")
  annualCost   Decimal? @map("annual_cost") @db.Decimal(12, 2)

  // Środowiska
  environments ApplicationEnvironment[]
  // Adresy IP, pod którymi aplikacja odpowiada
  ipAddresses  ApplicationIpAddress[]

  // Rekord demonstracyjny wstawiony przez seed, a nie przez człowieka.
  // Oznaczenie, po którym panel super administratora kasuje dane próbne
  // bez ryzyka trafienia w prawdziwy wpis — rozpoznawanie po nazwie
  // psułoby się po jej zmianie w interfejsie.
  isDemo Boolean @default(false) @map("is_demo")

  // Linki
  websiteUrl String? @map("website_url") @db.VarChar(500)
  docsUrl    String? @map("docs_url") @db.VarChar(500)
  repoUrl    String? @map("repo_url") @db.VarChar(500)
  runbookUrl String? @map("runbook_url") @db.VarChar(500)

  // Notatki o integracjach / wystawianych API
  integrations String? @db.Text

  // Metadane
  createdById String?   @map("created_by_id") @db.Uuid
  createdBy   User?    @relation("AppCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // Soft delete — zachowujemy historię zamiast kasować wpis
  deletedAt   DateTime? @map("deleted_at") @db.Date

  @@index([status])
  @@index([securityClass])
  @@index([criticality])
  @@index([ownerEmail])
  @@index([introducedOn])
  @@index([sunsetOn])
  @@index([deletedAt])
  @@index([deliveryType])
  // Indeks częściowy `WHERE is_demo = true` — migracja go tworzy ręcznie,
  // bo Prisma nie umie deklarować indeksu częściowego w `@@index`.
  @@map("applications")
}

// ─── Podsieci i adresy IP ──────────────────────────────────────
model Subnet {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.Citext
  // "10.20.0.0/16" — tekst, nie typ inet. Walidację zakresu robi
  // src/ipam/cidr.ts, bo chcemy ją testować bez bazy.
  cidr        String   @db.VarChar(18)
  description String?  @db.Text
  color       String   @default("slate") @db.VarChar(30)
  vlan        Int?     @db.SmallInt
  location    String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  addresses IpAddress[]

  @@map("subnets")
}

// Adres pojedynczy, właścicielem zakresu jest podsieć.
model IpAddress {
  id       String @id @default(uuid()) @db.Uuid
  subnetId String @map("subnet_id") @db.Uuid
  subnet   Subnet @relation(fields: [subnetId], references: [id], onDelete: Cascade)

  address String @db.VarChar(18) // pojedynczy IPv4, bez maski
  // Status jest tu, a nie na relacji: adres bywa zarezerwowany, zanim
  // ktokolwiek go przypisze, i relacja tego stanu nie odwzorowuje.
  status      IpStatus @default(FREE)
  description String?  @db.Text
  // Ostatnie potwierdzenie skanem (plan importu). Bez tej daty katalog
  // nie mówi, co zniknęło z sieci.
  lastSeenAt DateTime? @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applications ApplicationIpAddress[]

  @@unique([subnetId, address])
  @@index([status])
  @@map("ip_addresses")
}

// Jeden adres może obsługiwać kilka aplikacji (VIP, wiele usług na
// tym samym IP), a jedna aplikacja mieć ich kilka.
model ApplicationIpAddress {
  applicationId String   @map("application_id") @db.Uuid
  ipAddressId   String   @map("ip_address_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // onDelete: Cascade jest tu bezpieczne — kasowanie podsieci ma zabrać
  // przypisania razem z adresami, a nie zostawić martwe wiersze.
  ipAddress IpAddress @relation(fields: [ipAddressId], references: [id], onDelete: Cascade)

  @@id([applicationId, ipAddressId])
  @@index([ipAddressId])
  @@map("application_ip_addresses")
}

// ─── Ustawienia systemowe ──────────────────────────────────────
//
// Klucz-wartość, bo ustawień jest mało i każde ma inną interpretację
// wartości. Kolumna per ustawienie wymagałaby migracji przy każdym
// nowym przełączniku, a to najczęstsza zmiana w tym zestawie.
model Setting {
  key   String @id
  value String

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ─── Dziennik zdarzeń ─────────────────────────────────────────
model AuditLog {
  id     String @id @default(uuid()) @db.Uuid

  // Co się stało
  action String @db.VarChar(40)
  entity String @db.VarChar(60)
  // Klucz główny rekordu, którego dotyczy zdarzenie
  entityId String? @map("entity_id") @db.Uuid

  // Kto i skąd
  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String? @map("actor_name") @db.VarChar(200)

  // Zmiana: { pole: { from, to } }
  changes Json?

  ip        String? @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

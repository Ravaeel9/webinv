// Rejestr Oprogramowania — schemat bazy danych
// Dokumentacja pól: docs/ARCHITEKTURA.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Role i uprawnienia ───────────────────────────────────────
enum Role {
  SUPER_ADMIN // wszystko + zarządzanie użytkownikami
  ADMIN // CRUD aplikacji + odczyt userów + audyt
  VIEWER // tylko odczyt
}

// ─── Macierz uprawnień do aplikacji ───────────────────────────
// Poziom dostępu osoby do aplikacji. Inny niż `Role`: `Role` opisuje,
// co ktoś może robić w panelu, a ten poziom — co dostał w samej aplikacji.
// Nadajemy go w narzędziu IAM, a tutaj tylko ewidencjonujemy.
enum AccessLevel {
  OWNER     // właściciel
  ADMIN     // administrator
  USER      // użytkownik
  READ_ONLY // tylko odczyt
}

// ─── Klasyfikacja bezpieczeństwa ──────────────────────────────
enum SecurityClass {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

// ─── Status wdrożenia ─────────────────────────────────────────
enum AppStatus {
  PROD // używana produkcyjnie
  IN_USE // używana wewnątrz organizacji
  TEST // w testach
  DEV // w środowisku deweloperskim
  PLANNED // zaplanowana, jeszcze nie wdrożona
  DEPRECATED // wycofywana, wciąż w użyciu
  RETIRED // wycofana z użytku
}

// ─── Sposób dostarczenia i wsparcia ────────────────────────────
// Rejestr ma dwa zupełnie różne rodzaje wpisów. Jedne to programy
// instalowane na stanowisku (7-Zip, czytnik PDF), a drugie to usługi,
// do których łączymy się przez adres — hostowane u nas albo u dostawcy.
// Różnią się tym, czego potrzebujemy do opisania: dla usługi liczy się
// nie tylko „co to jest", ale też gdzie działa i do kogo dzwonić,
// gdy przestanie działać.
enum DeliveryType {
  GENERAL_USE    // program na stanowisku użytkownika
  SELF_HOSTED    // usługa na naszej infrastrukturze
  SAAS           // usługa u zewnętrznego dostawcy
  VENDOR_MANAGED // instalowana lokalnie, zarządza nią dostawca
}

// Kto odpowiada za wsparcie: my albo dostawca.
enum SupportOwnerType {
  INTERNAL
  VENDOR
}

// Główny kanał zgłoszeń — wystarczy jeden, bo to coś, czego szuka się
// w pierwszej kolejności.
enum SupportChannel {
  EMAIL
  PHONE
  PORTAL
  CHAT
  ON_SITE
}

// ─── Katalog adresów IP ───────────────────────────────────────
enum IpStatus {
  FREE       // wolny lub zarezerwowany, bez aplikacji
  IN_USE     // przypisany do co najmniej jednej aplikacji
  DEPRECATED // wycofywany, czeka na zwolnienie
}

// ─── Użytkownicy ──────────────────────────────────────────────
model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.Citext
  email        String    @unique @db.Citext
  fullName     String    @map("full_name") @db.VarChar(200)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role      @default(VIEWER)
  isActive     Boolean   @default(true) @map("is_active")
  // Wymuszenie zmiany hasła przy następnym logowaniu
  mustChangePassword Boolean @default(false) @map("must_change_password")
  // Płaska lista do szybkich testów — nie używamy tego w runtime
  passwordChangedAt DateTime? @map("password_changed_at")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Aplikacje utworzone przez użytkownika
  createdApps       Application[] @relation("AppCreator")

  sessions  Session[]
  auditLogs AuditLog[]
  accessVerifications AccessVerification[] @relation("AccessVerifications")

  @@map("users")
}

// ─── Sesje ────────────────────────────────────────────────────
model Session {
  id String @id @default(uuid()) @db.Uuid

  // W bazie trzymamy wyłącznie skrót tokenu — sam token jest tylko w ciasteczku
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  ip        String? @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(500)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── Środowiska ───────────────────────────────────────────────
model Environment {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.Citext
  // Kolejność na liście rozwijanej
  sortOrder Int       @default(0) @map("sort_order")
  color     String    @default("slate") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")

  applications ApplicationEnvironment[]

  @@map("environments")
}

// ─── Relacja aplikacja ↔ środowisko ──────────────────────────
model ApplicationEnvironment {
  applicationId String     @map("application_id") @db.Uuid
  environmentId String     @map("environment_id") @db.Uuid

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@id([applicationId, environmentId])
  @@index([environmentId])
  @@map("application_environments")
}

// ─── Aplikacje ────────────────────────────────────────────────
model Application {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique @db.Citext
  version     String @db.VarChar(100)

  // Co to jest i do czego służy
  description String? @db.Text
  purpose     String? @db.Text

  // Kto odpowiada — celowo osoby z ewidencji (`Person`), tym samym
  // katalogiem, z którego bierze się macierz uprawnień. Dawniej były tu
  // dwa mechanizmy: wolny e-mail właściciela i konta panelu jako
  // administratorzy — właściciel bez konta wypadał wtedy poza ewidencją,
  // a „administrator” prowadzony był na dwóch listach naraz. Skrzynka
  // zespołowa jako właściciel ma dziś tylko jedno miejsce: pole zostaje
  // puste (NULL), bo katalog imienny celowo nie zna skrzynek.
  ownerId String? @map("owner_person_id") @db.Uuid
  owner   Person? @relation("AppOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  admins  Person[] @relation("AppAdmins")

  // Kiedy
  introducedOn DateTime? @map("introduced_on") @db.Date
  sunsetOn     DateTime? @map("sunset_on") @db.Date

  // Bezpieczeństwo
  securityClass SecurityClass @default(INTERNAL) @map("security_class")
  // 1 = niska, 4 = krytyczna dla organizacji
  criticality   Int           @default(2) @db.SmallInt
  status        AppStatus     @default(PROD)

  // Czy uzyskanie dostępu do aplikacji wymaga formalnego wniosku
  accessRequestRequired Boolean @default(false) @map("access_request_required")

  // Sposób dostarczenia i hosting
  deliveryType DeliveryType @default(GENERAL_USE) @map("delivery_type")

  // Pola niżej opisują usługę, więc wypełnia się je dla typów innych niż
  // `GENERAL_USE`. Celowo zostają w rekordzie, gdy typ wraca do
  // `GENERAL_USE` — zmiana typu to zmiana opisu, nie skasowanie wiedzy.
  baseUrl         String? @db.VarChar(500) @map("base_url")
  hostingLocation String? @db.VarChar(200) @map("hosting_location")
  adminTeam       String? @db.VarChar(200) @map("admin_team")

  // Wsparcie: kto, jak i pod jakim kontaktem
  supportOwnerType SupportOwnerType? @map("support_owner_type")
  supportOwnerName String?          @db.VarChar(200) @map("support_owner_name")
  supportEmail     String?          @db.Citext @map("support_email")
  supportUrl       String?          @db.VarChar(500) @map("support_url")
  supportChannel   SupportChannel?  @map("support_channel")
  supportNotes     String?          @db.Text @map("support_notes")

  // Dostawca i licencja
  vendor       String? @db.VarChar(200)
  license      String? @db.VarChar(200)
  licenseCount Int?    @map("license_count")
  annualCost   Decimal? @map("annual_cost") @db.Decimal(12, 2)

  // Środowiska
  environments ApplicationEnvironment[]
  // Macierz uprawnień: kto ma dostęp do tej aplikacji
  accessGrants ApplicationAccess[] @relation("AppAccess")
  // Przeglądy dostępów: historia weryfikacji tej aplikacji
  verifications AccessVerification[] @relation("AppVerifications")
  // Adresy IP, pod którymi aplikacja odpowiada
  ipAddresses  ApplicationIpAddress[]

  // Rekord demonstracyjny wstawiony przez seed, a nie przez człowieka.
  // Oznaczenie, po którym panel super administratora kasuje dane próbne
  // bez ryzyka trafienia w prawdziwy wpis — rozpoznawanie po nazwie
  // psułoby się po jej zmianie w interfejsie.
  isDemo Boolean @default(false) @map("is_demo")

  // Linki
  websiteUrl String? @map("website_url") @db.VarChar(500)
  docsUrl    String? @map("docs_url") @db.VarChar(500)
  repoUrl    String? @map("repo_url") @db.VarChar(500)
  runbookUrl String? @map("runbook_url") @db.VarChar(500)

  // Notatki o integracjach / wystawianych API
  integrations String? @db.Text

  // Metadane
  createdById String?   @map("created_by_id") @db.Uuid
  createdBy   User?    @relation("AppCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // Soft delete — zachowujemy historię zamiast kasować wpis
  deletedAt   DateTime? @map("deleted_at") @db.Date

  @@index([status])
  @@index([securityClass])
  @@index([criticality])
  @@index([ownerId])
  @@index([introducedOn])
  @@index([sunsetOn])
  @@index([deletedAt])
  @@index([deliveryType])
  // Indeks częściowy `WHERE is_demo = true` — migracja go tworzy ręcznie,
  // bo Prisma nie umie deklarować indeksu częściowego w `@@index`.
  @@map("applications")
}

// ─── Osoby mające dostęp do aplikacji ──────────────────────────
// Osobno od `User`, bo większość osób z ewidencji nie ma konta w panelu
// i nie musi się logować — dostęp nadaje się w narzędziu IAM, a my
// tylko zapisujemy, komu go nadano. Powiązanie z `User` byłoby więc
// zmyśloną zależnością dla większości wierszy.
model Person {
  id        String @id @default(uuid()) @db.Uuid
  firstName String @map("first_name") @db.VarChar(100)
  lastName  String @map("last_name") @db.VarChar(100)
  // Klucz tożsamości osoby. `@db.Citext` sprawia, że `Jan.Kowalski@firma.pl`
  // i `jan.kowalski@firma.pl` to jeden adres — inaczej ta sama osoba
  // wchodziłaby do katalogu dwa razy pod dwoma adresami.
  email      String  @unique @db.Citext
  // Stanowisko i dział jako wolny tekst: struktura organizacyjna zmienia się
  // częściej niż schemat bazy, a słowniki wymuszałyby migrację przy każdej
  // reorganizacji działów.
  position   String? @db.VarChar(150)
  department String? @db.VarChar(150)
  // Nieaktywność (isActive=false) to zwykłe odejście z organizacji — przypisania
  // zostają czytelne. Twarde kasowanie wiersza jest zarezerwowane dla błędnie
  // wprowadzonych wpisów; kaskada przy `ApplicationAccess.person` sprząta
  // wtedy przypisania razem z osobą.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  access ApplicationAccess[]
  verifications AccessVerification[]
  ownedApps Application[] @relation("AppOwner")
  adminApps Application[] @relation("AppAdmins")

  @@index([lastName])
  @@map("persons")
}

// Jedno przypisanie: ta osoba ma dostęp do tej aplikacji na tym poziomie.
// Klucz złożony zabrania wpisania tej samej osoby dwa razy do tej samej
// aplikacji — to była najczęstsza pomyłka przy ręcznym prowadzeniu ewidencji.
model ApplicationAccess {
  applicationId String      @map("application_id") @db.Uuid
  personId      String      @map("person_id") @db.Uuid
  level         AccessLevel @default(USER)
  grantedOn     DateTime    @default(now()) @map("granted_on") @db.Date
  // Data ostatniego przeglądu tego przypisania — stawia ją wpis
  // weryfikacji obejmujący ten grant (całą macierz, aplikację albo
  // pojedynczy wiersz). Null znaczy „nigdy nie zweryfikowano"; zmiana
  // poziomu grantu kasuje znacznik, bo potwierdzenie dotyczyło dawnego
  // stanu dostępu.
  verifiedOn DateTime? @map("verified_on") @db.Date
  // Dostęp tymczasowy. Data wygasania nie kasuje wiersza — historia
  // nadania zostaje, a wiersz oznacza w macierzy jako wygasły.
  expiresOn DateTime? @map("expires_on") @db.Date
  note      String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  application Application @relation("AppAccess", fields: [applicationId], references: [id], onDelete: Cascade)
  // onDelete: Cascade przy osobie też jest bezpieczne: dezaktywację robimy
  // przez `isActive=false`, więc kasowanie zdarza się tylko przy naprawdę
  // błędnym wpisie — i wtedy jego przypisania są już nieaktualne.
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([applicationId, personId])
  @@index([personId])
  @@index([expiresOn])
  @@map("application_access")
}

// ─── Weryfikacje dostępów (przeglądy macierzy) ─────────────────
// Jeden wpis = jedno potwierdzenie: „dnia X osoba Y sprawdziła, że
// zapisane dostępy są aktualne". Zakres bywa trójstopniowy — cała
// macierz, jedna aplikacja albo pojedynczy wiersz — dlatego aplikacja
// i osoba są opcjonalne. Obok identyfikatorów trzymamy migawki nazwisk:
// przegląd sprzed roku ma pozostać czytelny, gdy osoba odejdzie
// (SetNull przy `person`), a konto weryfikującego zostanie skasowane.
enum VerificationScope {
  MATRIX      // cała macierz — wszystkie aplikacje z macierzą
  APPLICATION // jedna aplikacja
  GRANT       // jeden wiersz macierzy (osoba + aplikacja)
}

model AccessVerification {
  id         String            @id @default(uuid()) @db.Uuid
  scope      VerificationScope
  // Data przeglądu, nie moment zapisu wpisu — przegląd bywa rozliczany
  // wstecz, a forma `@db.Date` odpowiada datom nadania w macierzy.
  verifiedOn DateTime          @map("verified_on") @db.Date
  note       String?           @db.Text

  // Zakres: `applicationId` jest null tylko dla MATRIX; `personId` tylko
  // dla GRANT. Kaskada przy aplikacji — kasowanie aplikacji zabiera jej
  // przeglądy, tak samo zabiera granty.
  applicationId String?      @map("application_id") @db.Uuid
  application   Application? @relation("AppVerifications", fields: [applicationId], references: [id], onDelete: Cascade)
  personId    String?  @map("person_id") @db.Uuid
  person      Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  // Migawka nazwiska osoby z grantu — po usunięciu osoby (SetNull) wpis
  // wciąż mówi, kogo wtedy dotyczył. 255, bo DTO dopuszcza imię i
  // nazwisko po 100 znaków — razem ze spacją 201, ponad dawne 200.
  personName  String?  @map("person_name") @db.VarChar(255)

  // Kto weryfikował — zawsze zalogowany użytkownik panelu, kopiowane
  // z sesji jak w `AuditLog`.
  actorId   String? @map("actor_id") @db.Uuid
  actor     User?   @relation("AccessVerifications", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String? @map("actor_name") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([applicationId])
  @@index([verifiedOn])
  // Blokada 24 h i okno historii filtrują po `createdAt` — bez indeksu
  // każde sprawdzenie blokady to pełny skan tabeli.
  @@index([createdAt])
  @@map("access_verifications")
}

// ─── Podsieci i adresy IP ──────────────────────────────────────
model Subnet {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.Citext
  // "10.20.0.0/16" — tekst, nie typ inet. Walidację zakresu robi
  // src/ipam/cidr.ts, bo chcemy ją testować bez bazy.
  cidr        String   @db.VarChar(18)
  description String?  @db.Text
  color       String   @default("slate") @db.VarChar(30)
  vlan        Int?     @db.SmallInt
  location    String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  addresses IpAddress[]

  @@map("subnets")
}

// Adres pojedynczy, właścicielem zakresu jest podsieć.
model IpAddress {
  id       String @id @default(uuid()) @db.Uuid
  subnetId String @map("subnet_id") @db.Uuid
  subnet   Subnet @relation(fields: [subnetId], references: [id], onDelete: Cascade)

  address String @db.VarChar(18) // pojedynczy IPv4, bez maski
  // Status jest tu, a nie na relacji: adres bywa zarezerwowany, zanim
  // ktokolwiek go przypisze, i relacja tego stanu nie odwzorowuje.
  status      IpStatus @default(FREE)
  description String?  @db.Text
  // Ostatnie potwierdzenie skanem (plan importu). Bez tej daty katalog
  // nie mówi, co zniknęło z sieci.
  lastSeenAt DateTime? @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applications ApplicationIpAddress[]

  @@unique([subnetId, address])
  @@index([status])
  @@map("ip_addresses")
}

// Jeden adres może obsługiwać kilka aplikacji (VIP, wiele usług na
// tym samym IP), a jedna aplikacja mieć ich kilka.
model ApplicationIpAddress {
  applicationId String   @map("application_id") @db.Uuid
  ipAddressId   String   @map("ip_address_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // onDelete: Cascade jest tu bezpieczne — kasowanie podsieci ma zabrać
  // przypisania razem z adresami, a nie zostawić martwe wiersze.
  ipAddress IpAddress @relation(fields: [ipAddressId], references: [id], onDelete: Cascade)

  @@id([applicationId, ipAddressId])
  @@index([ipAddressId])
  @@map("application_ip_addresses")
}

// ─── Ustawienia systemowe ──────────────────────────────────────
//
// Klucz-wartość, bo ustawień jest mało i każde ma inną interpretację
// wartości. Kolumna per ustawienie wymagałaby migracji przy każdym
// nowym przełączniku, a to najczęstsza zmiana w tym zestawie.
model Setting {
  key   String @id
  value String

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ─── Dziennik zdarzeń ─────────────────────────────────────────
model AuditLog {
  id     String @id @default(uuid()) @db.Uuid

  // Co się stało
  action String @db.VarChar(40)
  entity String @db.VarChar(60)
  // Klucz główny rekordu, którego dotyczy zdarzenie
  entityId String? @map("entity_id") @db.Uuid

  // Kto i skąd
  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String? @map("actor_name") @db.VarChar(200)

  // Zmiana: { pole: { from, to } }
  changes Json?

  ip        String? @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Testy nigdy nie są emitowane — uruchamia je tsx, który zdejmuje
    // typy, ale ich NIE sprawdza. Dlatego osobny config: główny ma
    // `include: ["src/**/*"]` i `rootDir: ./src`, a dorzucenie testów
    // do niego wywaliłoby `nest build`.
    "noEmit": true,
    "incremental": false,
    "tsBuildInfoFile": null,
    // `rootDir` z głównego configu to `./src`; samo `noEmit` nie
    // znosi tego sprawdzenia (TS6059), a testy leżą poza `src`.
    "rootDir": "../.."
  },
  // Wpisy spoza `apps/api` to cel: `password-parity.test.ts` porównuje
  // politykę haseł serwera z jej kopią w interfejsie, a
  // `build-query.test.ts` pilnuje budowania query stringa. Oba pliki
  // są celowo wolne od `import.meta` — inaczej nie dało by się ich
  // zaimportować w CommonJS (stąd `query.ts` wydzielony z `api.ts`).
  "include": [
    "test/**/*",
    "../web/src/lib/password.ts",
    "../web/src/lib/query.ts",
    "../web/src/lib/version.ts",
    "../web/src/types.ts"
  ]
}

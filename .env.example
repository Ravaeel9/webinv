# ─────────────────────────────────────────────────────────────
#  Kopia tego pliku: cp .env.example .env  i uzupełnij wartości
# ─────────────────────────────────────────────────────────────

# ── Konto super admina tworzone przy pierwszym starcie ──────
# Puste = kontener nie wstanie z komunikatem (tak jest bezpieczniej
# niż domyślne hasło, którego nikt nie zmieni).
#
# Hasło musi spełniać tę samą politykę co hasła w UI: min. 12 znaków,
# mała i wielka litera, cyfra oraz znak specjalny. Niespełnienie tego
# warunku zatrzymuje start — świadomie, także wtedy, gdy konto już
# istnieje. Wtedy zmiana hasła w .env nie zrobiłaby nic, więc ciche
# zignorowanie byłoby bardziej mylące niż błąd.
# Wygeneruj np.: openssl rand -base64 24
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@firma.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULLNAME=Administrator Systemu

# Zestaw 20 programów demonstracyjnych do obejrzenia interfejsu.
# Domyślnie wyłączony. Włączaj tylko na środowiskach deweloperskich —
# seed startuje przy każdym uruchomieniu kontenera, więc na produkcji
# wpisałby do bazy dwadzieścia programów do odinstalowania.
SEED_DEMO_APPS=false

# ── Sesje ────────────────────────────────────────────────────
# Wygeneruj: openssl rand -hex 32
SESSION_SECRET=

# Ile dnia ważna jest sesja
SESSION_TTL_DAYS=7

# Ustaw true gdy aplikacja stoi za HTTPS (ciasteczko Secure)
COOKIE_SECURE=false

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=webinv
POSTGRES_PASSWORD=
POSTGRES_DB=webinv

# ── Nginx / porty ────────────────────────────────────────────
# Port na hoście, pod którym odpala się całość
APP_PORT=8080

# Wersja wplatana do interfejsu (widoczna w prawym dolnym rogu).
# Zwykle nie ustawiaj tego — `make up` bierze wersję z pola `version`
# w package.json. Ustaw tylko przy budowaniu obrazu poza makefile,
# np. `docker compose build` w potoku CI: wtedy puste znaczy
# `0.0.0-dev`, co widać w interfejsie zamiast udawać wersję produkcyjną.
APP_VERSION=

# ── CORS ─────────────────────────────────────────────────────
# Dodatkowe dozwolone źródła po przecinku (albo puste = tylko ten sam host)
CORS_ORIGINS=

# ── Rate limit logowania ─────────────────────────────────────
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=15m

# ── Wewnętrzne CA (https integracji, np. GLPI) ───────────────
# Integracja GLPI może stać za https z certyfikatem podpisanym własnym
# CA. Włóż plik certyfikatu root (PEM) jako ca.crt obok
# docker-compose.yml — compose sam zamontuje go do kontenera api.
# Poniższa ścieżka to miejsce w kontenerze; zmieniaj tylko, gdy
# nadpisujesz też montaż w docker-compose.yml.
NODE_EXTRA_CA_CERTS=/etc/ssl/glpi-ca.crt

# ── Port bazy dla prac lokalnych ────────────────────────────
# Używany wyłącznie przez docker-compose.dev.yml (Prisma Studio, psql).
# 55432, bo 5432 na hoście zajmuje inny projekt.
DB_DEV_PORT=55432

{
  "name": "webinv",
  "version": "1.5.9",
  "private": true,
  "description": "Rejestr oprogramowania używanego w organizacji",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "fastify": "5.12.7"
  },
  "scripts": {
    "dev:api": "npm run start:dev --workspace @webinv/api",
    "dev:web": "npm run dev --workspace @webinv/web",
    "build": "npm run build --workspace @webinv/api && npm run build --workspace @webinv/web",
    "test:web-build": "npm run build --workspace @webinv/web",
    "test": "npm run test:web-build && npm run test --workspace @webinv/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @webinv/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @webinv/api",
    "prisma:studio": "npm run prisma:studio --workspace @webinv/api"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
